default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_P8_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    setup_ci

    bundle_id = "com.dijitalmentalikizim.app"
    existing = Spaceship::ConnectAPI::BundleId.find(bundle_id)
    if existing.nil?
      UI.message("Registering bundle id #{bundle_id}")
      Spaceship::ConnectAPI::BundleId.create(name: "Dijital Mental Ikiz", platform: "IOS", identifier: bundle_id)
    else
      UI.message("Bundle id #{bundle_id} already registered")
    end

    # Enable capabilities required by App.entitlements (HealthKit, Sign in with Apple)
    bundle = Spaceship::ConnectAPI::BundleId.find(bundle_id)
    ["HEALTHKIT", "APPLE_ID_AUTH"].each do |capability|
      begin
        bundle.create_capability(capability)
        UI.message("Enabled capability #{capability}")
      rescue => e
        UI.message("Capability #{capability} not changed: #{e.message}")
      end
    end

    match(
      type: "appstore",
      readonly: false,
      force: true, # regenerate the profile so it includes the capabilities above
      git_url: "git@github.com:usecomus-afk/purelyistanbul-certs.git",
      app_identifier: "com.dijitalmentalikizim.app",
      username: "fastlane"
    )

    update_project_team(
      path: "ios/App/App.xcodeproj",
      teamid: "R8LQC6KZG8"
    )

    update_project_provisioning(
      xcodeproj: "ios/App/App.xcodeproj",
      profile: ENV["sigh_com.dijitalmentalikizim.app_appstore_profile-path"],
      build_configuration: "Release"
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"],
      xcodeproj: "ios/App/App.xcodeproj"
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "mentaldijitalikiz.ipa",
      xcargs: "DEVELOPMENT_TEAM=R8LQC6KZG8 CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\""
    )

    upload_to_testflight(
      ipa: "./build/mentaldijitalikiz.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
