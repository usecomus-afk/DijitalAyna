  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npx -y firebase-tools deploy --only hosting",
    "deploy:preview": "npm run build && npx -y firebase-tools hosting:channel:deploy preview",
    "serve:firebase": "npx -y firebase-tools emulators:start --only hosting",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:build": "npm run build && npx cap copy ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
